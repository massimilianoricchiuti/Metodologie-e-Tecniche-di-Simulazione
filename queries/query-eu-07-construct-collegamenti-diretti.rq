PREFIX arco: <https://w3id.org/arco/ontology/arco/>
PREFIX a-loc: <https://w3id.org/arco/ontology/location/>
PREFIX arco-lite: <https://w3id.org/arco/ontology/arco-lite/>

# Materializza i soli collegamenti di rinvenimento esplicitamente
# qualificati nel pattern di localizzazione ArCo osservato dalla Q3.
# Il risultato è un grafo locale: l'endpoint sorgente non viene modificato.
CONSTRUCT {
  ?entity arco-lite:hasFindingLocation ?site .
}
WHERE {
  VALUES ?site {
    <https://w3id.org/arco/resource/Site/341671000c872aa799b1e99ae08ca1e8>
  }

  ?entity a arco:ArchaeologicalProperty ;
          a-loc:hasTimeIndexedTypedLocation ?location .
  ?location a a-loc:TimeIndexedTypedLocation ;
            a-loc:atSite ?site ;
            a-loc:hasLocationType a-loc:FindingLocation .
}
