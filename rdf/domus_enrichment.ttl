@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cis: <http://dati.beniculturali.it/cis/> .
@prefix arco: <https://w3id.org/arco/ontology/arco/> .
@prefix domus-onto: <https://massimilianoricchiuti.github.io/gepid-domus-chirurgo/ontology/> .

#################################################################
# Arricchimento finale
# Il collegamento esplicita in forma diretta la relazione già
# documentata dalla query Q3 attraverso il pattern di
# localizzazione ArCo.
#################################################################

domus-onto:hasArchaeologicalContextSite a rdf:Property ;
  rdfs:label "has archaeological context site"@en ,
             "è collegato al sito archeologico"@it ;
  rdfs:comment "Collega direttamente un bene archeologico al sito già raggiunto tramite la localizzazione indicizzata nel tempo, senza sostituire il pattern ArCo esistente."@it ;
  rdfs:domain arco:ArchaeologicalProperty ;
  rdfs:range cis:Site ;
  rdfs:subPropertyOf dcterms:spatial .

<https://w3id.org/arco/resource/ArchaeologicalProperty/0800675608>
  domus-onto:hasArchaeologicalContextSite
  <https://w3id.org/arco/resource/Site/341671000c872aa799b1e99ae08ca1e8> .
